# vLLM Server (GPU node, podman-compose)
# GPU node 上で `cp env.example .env` してから値を埋める。

# --- Image ---
# 固定タグを使う。`latest` は不可（docs/llm.md 参照）。
# 例: v0.7.3 / v0.8.5 等、検証済みの版を指定する。
VLLM_IMAGE_TAG=v0.7.3

# --- Container ---
VLLM_GPU_DEVICE=0
VLLM_HOST_PORT=3200

# --- API key (必須) ---
# 生成: openssl rand -hex 32
# portal app の BFF (`LLM_API_KEY`) と同値にする。
VLLM_API_KEY=

# --- Model (本番固定) ---
# 評価結果は .claude/docs/llm-experiment.md を参照。
MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ

# OpenAI 互換 API で叩く際の別名。空なら MODEL がそのまま使われる。
SERVED_MODEL_NAME=

# モデル config に明示が無いとき用。Qwen 公式 AWQ は空で OK。
QUANTIZATION=

# Mistral 公式 native format 用。HF 形式の Qwen では空で OK。
TOKENIZER_MODE=
CONFIG_FORMAT=
LOAD_FORMAT=

# --- Runtime ---
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.92

# --- HuggingFace cache ---
# Lustre (~ ) ではなく GPU node ローカルの /data1 に置くこと
# (mmap 性能 / overlayfs 非対応)。プロジェクト固有パスで user 切替の影響を受けない。
HF_HOME=/data1/db-portal/llm/models
