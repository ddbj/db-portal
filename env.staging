# DB Portal Staging Environment

# --- Compose ---
COMPOSE_FILE=compose.yml:compose.podman.yml
DB_PORTAL_ENV=staging
TZ=Asia/Tokyo
APP_COMMAND=sh -c "npm run build && npm run start"
APP_PORT=3100
APP_INTERNAL_PORT=3100

# --- Keycloak (DDBJ Account staging) ---
KEYCLOAK_REALM_URL=https://idp-staging.ddbj.nig.ac.jp/realms/master
KEYCLOAK_CLIENT_ID=db-portal-dev

# --- Search API ---
VITE_DB_PORTAL_SEARCH_API_URL=https://ddbj-staging.nig.ac.jp/search/api

# --- Portal origin (canonical URL 等で参照、docs/deployment.md 参照) ---
VITE_PORTAL_ORIGIN=https://portal-staging.ddbj.nig.ac.jp

# --- LLM (BFF + vLLM serving)
# このファイルは a012 (portal app) と nig-gpu-2 (vLLM) が Lustre 経由で共有する。
# BFF 用変数 (LLM_BASE_URL / LLM_API_KEY / LLM_MODEL) と vLLM serving 用変数を 1 つの .env に同居させる。
# 詳細は docs/llm.md を参照。
LLM_BASE_URL=http://l40s-03:3200
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ
LLM_IMAGE_TAG=v0.7.3
LLM_GPU_DEVICE=0
LLM_HOST_PORT=3200
LLM_MAX_MODEL_LEN=8192
LLM_GPU_MEMORY_UTILIZATION=0.92
LLM_HF_HOME=/data1/db-portal/llm/models
LLM_QUANTIZATION=
LLM_SERVED_MODEL_NAME=
LLM_TOKENIZER_MODE=
LLM_CONFIG_FORMAT=
LLM_LOAD_FORMAT=
