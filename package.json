{
  "name": "db-portal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "npm run gen:last-updated && npm run gen:breadcrumb-titles && npm run validate:content && tsx watch --include 'app/**/*' --include 'server/**/*' server/index.ts",
    "build": "npm run gen:last-updated && npm run gen:breadcrumb-titles && npm run validate:content && NODE_ENV=production react-router build && npm run build:bff",
    "build:bff": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node26 --packages=external --outfile=build/bff/index.js",
    "start": "npm run gen:last-updated && npm run gen:breadcrumb-titles && npm run validate:content && NODE_ENV=production tsx server/index.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:pbt": "vitest run tests/pbt",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "gen:last-updated": "tsx scripts/gen-last-updated.ts",
    "gen:breadcrumb-titles": "tsx scripts/gen-breadcrumb-titles.ts",
    "gen:api-types": "dotenv -- openapi-typescript $DB_PORTAL_OPENAPI_URL -o app/lib/api/openapi-types.ts",
    "news:repos:sync": "bash scripts/news-repos-sync.sh"
  },
  "dependencies": {
    "@react-router/express": "^8.5.0",
    "@react-router/node": "^8.5.0",
    "@tanstack/react-query": "^5.104.5",
    "cookie": "^2.0.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "github-slugger": "^2.0.0",
    "i18next": "^26.5.6",
    "isbot": "^5",
    "jose": "^6.2.13",
    "js-yaml": "^5.5.0",
    "mermaid": "^12.2.0",
    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.3",
    "react-router": "^8.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@fast-check/vitest": "^0.5.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.5.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unist": "^3.0.3",
    "@vitest/eslint-plugin": "1.6.27",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
