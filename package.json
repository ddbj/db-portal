{
  "name": "db-portal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "npm run gen:last-updated && npm run gen:breadcrumb-titles && npm run validate:content && tsx watch --include 'app/**/*' --include 'server/**/*' server/index.ts",
    "build": "npm run gen:last-updated && npm run gen:breadcrumb-titles && npm run validate:content && NODE_ENV=production react-router build",
    "start": "npm run gen:last-updated && npm run gen:breadcrumb-titles && npm run validate:content && NODE_ENV=production tsx server/index.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:pbt": "vitest run tests/pbt",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "gen:last-updated": "tsx scripts/gen-last-updated.ts",
    "gen:breadcrumb-titles": "tsx scripts/gen-breadcrumb-titles.ts",
    "gen:api-types": "dotenv -- openapi-typescript $DB_PORTAL_OPENAPI_URL -o app/lib/api/openapi-types.ts",
    "news:repos:sync": "bash scripts/news-repos-sync.sh"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "^5.2.10",
    "@react-router/express": "^8.4.0",
    "@react-router/node": "^8.4.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.99.2",
    "cookie": "^1.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.5.2",
    "github-slugger": "^2.0.0",
    "i18next": "^26.0.6",
    "isbot": "^5",
    "jose": "^6.2.3",
    "js-yaml": "^4.1.1",
    "mermaid": "^12.2.0",
    "minisearch": "^7.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.4",
    "react-router": "^8.4.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@fast-check/vitest": "^0.5.0",
    "@playwright/test": "^1.50.0",
    "@react-router/dev": "^8.4.0",
    "@stylistic/eslint-plugin": "^4.1.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/eslint-plugin": "^1.1.25",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.18.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "fast-check": "^4.7.0",
    "globals": "^16.0.0",
    "jiti": "^2.4.2",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.19.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
