# === Common ===
DB_PORTAL_PREFIX=db-portal-prod
DB_PORTAL_ENV=production
TZ=Asia/Tokyo
NODE_ENV=production

# === App ===
DB_PORTAL_APP_COMMAND=sh -c "npm run build && npm start"
DB_PORTAL_APP_PORT=3200
DB_PORTAL_APP_INTERNAL_PORT=3000
DB_PORTAL_PORTAL_ORIGIN=https://portal.ddbj.nig.ac.jp
DB_PORTAL_LOG_LEVEL=warn
DB_PORTAL_DEFAULT_LANG=ja

# === Search API ===
DB_PORTAL_SEARCH_API_URL=https://ddbj.nig.ac.jp/search/api
DB_PORTAL_SEARCH_API_TIMEOUT_MS=10000
DB_PORTAL_OPENAPI_URL=https://ddbj.nig.ac.jp/search/api/openapi.json

# === Auth (Keycloak) ===
DB_PORTAL_KEYCLOAK_REALM_URL=https://idp.ddbj.nig.ac.jp/realms/master
DB_PORTAL_KEYCLOAK_CLIENT_ID=db-portal
DB_PORTAL_AUTH_SESSION_TTL_SECONDS=1800

# === LLM ===
DB_PORTAL_LLM_BASE_URL=http://l40s-03:3200
DB_PORTAL_LLM_API_KEY=CHANGE_ME
DB_PORTAL_LLM_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ
DB_PORTAL_LLM_TIMEOUT_MS=60000
DB_PORTAL_LLM_RATE_LIMIT_PER_IP_MIN=60
DB_PORTAL_LLM_RATE_LIMIT_PER_SESSION_MIN=30

# === News mirror (ddbj / dbcls 並列、同じインターバルで取得) ===
DB_PORTAL_NEWS_REPOS_DIR=./cache/repos
DB_PORTAL_NEWS_DDBJ_REPO_URL=https://github.com/ddbj/www.git
DB_PORTAL_NEWS_MIRROR_DDBJ_BRANCH=main
DB_PORTAL_NEWS_DBCLS_REPO_URL=https://github.com/dbcls/website.git
DB_PORTAL_NEWS_MIRROR_DBCLS_BRANCH=master
DB_PORTAL_NEWS_MIRROR_INTERVAL_SECONDS=1800
DB_PORTAL_NEWS_CACHE_DIR=./cache/news

# === Services mirror (news clone を再利用) ===
DB_PORTAL_SERVICES_CACHE_DIR=./cache/services
