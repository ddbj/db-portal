# === Common ===
DB_PORTAL_PREFIX=db-portal-dev
DB_PORTAL_ENV=dev
TZ=Asia/Tokyo
NODE_ENV=development

# === App ===
DB_PORTAL_APP_COMMAND=npm run dev
DB_PORTAL_APP_PORT=3000
DB_PORTAL_APP_INTERNAL_PORT=3000
DB_PORTAL_PORTAL_ORIGIN=http://localhost:3000
DB_PORTAL_LOG_LEVEL=debug
DB_PORTAL_DEFAULT_LANG=ja

# === Search API ===
DB_PORTAL_SEARCH_API_URL=https://ddbj-staging.nig.ac.jp/search/api
DB_PORTAL_SEARCH_API_TIMEOUT_MS=10000
DB_PORTAL_OPENAPI_URL=https://ddbj-staging.nig.ac.jp/search/api/openapi.json

# === Auth (Keycloak) ===
DB_PORTAL_KEYCLOAK_REALM_URL=https://idp-staging.ddbj.nig.ac.jp/realms/master
DB_PORTAL_KEYCLOAK_CLIENT_ID=db-portal-dev
DB_PORTAL_AUTH_SESSION_TTL_SECONDS=1800

# === LLM ===
# dev は dummy URL を入れて AI assistant box を表示させる (接続は失敗するが UI は確認可能)
# 未設定 (空文字) にすると box は hide される
DB_PORTAL_LLM_BASE_URL=https://example.com/llm
DB_PORTAL_LLM_API_KEY=
DB_PORTAL_LLM_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ
DB_PORTAL_LLM_TIMEOUT_MS=60000
DB_PORTAL_LLM_RATE_LIMIT_PER_IP_MIN=60
DB_PORTAL_LLM_RATE_LIMIT_PER_SESSION_MIN=30

# === News mirror ===
DB_PORTAL_NEWS_MIRROR_DDBJ_REPO=ddbj/www
DB_PORTAL_NEWS_MIRROR_DDBJ_BRANCH=main
DB_PORTAL_NEWS_MIRROR_DBCLS_REPO=dbcls/website
DB_PORTAL_NEWS_MIRROR_DBCLS_BRANCH=master
DB_PORTAL_NEWS_MIRROR_INTERVAL_SECONDS=1800
DB_PORTAL_NEWS_MIRROR_GITHUB_TOKEN=
DB_PORTAL_NEWS_CACHE_DIR=/var/cache/db-portal/news
